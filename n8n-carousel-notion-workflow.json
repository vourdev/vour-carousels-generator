{
  "name": "Automation - Vour Carousels Generator (Midnight Notion)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 * * *"
            }
          ]
        }
      },
      "id": "5a41bf63-810a-42c2-8409-f8df930c2eb7",
      "name": "Schedule Trigger (Midnight)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "resource": "databaseItem",
        "operation": "getAll",
        "databaseId": {
          "__rl": true,
          "mode": "list",
          "value": "3a70f2313d318149a49ef0dc4fc494bf"
        },
        "filterType": "manual",
        "filters": {
          "conditions": [
            {
              "key": "Status",
              "comparison": "equals",
              "value": "Ready"
            }
          ]
        },
        "options": {
          "limit": 1
        }
      },
      "id": "d0fa1e6f-4bc1-4475-ae90-c2665e714652",
      "name": "Notion (Get Next Topic)",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [
        470,
        300
      ],
      "notesInFlow": true,
      "notes": "Reads the first page in database with Status 'Ready'"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://vour-carousels-generator.vercel.app/api/n8n-generate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "3u820qD0ZIPTI6dRDmmvQ3hWh8jNLa5W7slDkp/oBhs="
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "topic",
              "value": "={{ $json.properties.Topic.title[0].plain_text }}"
            }
          ]
        },
        "options": {}
      },
      "id": "b3e0c0de-e2e0-466d-a77a-4467d02df912",
      "name": "HTTP Request (Vour API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        690,
        300
      ]
    },
    {
      "parameters": {
        "resource": "databaseItem",
        "operation": "update",
        "databaseId": {
          "__rl": true,
          "mode": "list",
          "value": "={{ $node[\"Notion (Get Next Topic)\"].parameter[\"databaseId\"] }}"
        },
        "pageId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $node[\"Notion (Get Next Topic)\"].json[\"id\"] }}"
        },
        "properties": {
          "propertyList": [
            {
              "key": "Status",
              "value": "Scheduled"
            }
          ]
        }
      },
      "id": "f53e6b22-8cc2-4ef8-82e1-454afb79c3b8",
      "name": "Notion (Update Status to Scheduled)",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [
        910,
        300
      ]
    }
  ],
  "connections": {
    "Schedule Trigger (Midnight)": {
      "main": [
        [
          {
            "node": "Notion (Get Next Topic)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notion (Get Next Topic)": {
      "main": [
        [
          {
            "node": "HTTP Request (Vour API)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request (Vour API)": {
      "main": [
        [
          {
            "node": "Notion (Update Status to Scheduled)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
