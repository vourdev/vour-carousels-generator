{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/slide/**",
              "deck-stage.js"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Sora|Nunito|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Sora, Nunito, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='BigStat'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|unit|caption|captionEyebrow|align|style|key|ref|className|style|children)$/]",
        "message": "<BigStat> doesn't accept that prop. Declared props: number, unit, caption, captionEyebrow, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BigStat'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|left)$/]",
        "message": "<BigStat> align must be one of 'center' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|image|alt|style|key|ref|className|style|children)$/]",
        "message": "<BrandMark> doesn't accept that prop. Declared props: size, image, alt, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DarkCallout'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|children|style|key|ref|className|style|children)$/]",
        "message": "<DarkCallout> doesn't accept that prop. Declared props: icon, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Highlight'] > JSXAttribute > JSXIdentifier[name!=/^(?:strong|sub|style|key|ref|className|style|children)$/]",
        "message": "<Highlight> doesn't accept that prop. Declared props: strong, sub, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImagePlate'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|variant|fit|ratio|chromeLabel|url|caption|captionEyebrow|children|style|key|ref|className|style|children)$/]",
        "message": "<ImagePlate> doesn't accept that prop. Declared props: src, alt, variant, fit, ratio, chromeLabel, url, caption, captionEyebrow, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImagePlate'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:framed|window-mac|window-web|phone|plain)$/]",
        "message": "<ImagePlate> variant must be one of 'framed' | 'window-mac' | 'window-web' | 'phone' | 'plain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImagePlate'] > JSXAttribute[name.name='fit'] > Literal[value!=/^(?:cover|contain)$/]",
        "message": "<ImagePlate> fit must be one of 'cover' | 'contain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfoCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|title|body|label|labelTone|children|style|key|ref|className|style|children)$/]",
        "message": "<InfoCard> doesn't accept that prop. Declared props: tone, icon, title, body, label, labelTone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfoCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:peach|stone|mint|sky|pink|amber)$/]",
        "message": "<InfoCard> tone must be one of 'peach' | 'stone' | 'mint' | 'sky' | 'pink' | 'amber'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MediaGrid'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|columns|gap|style|key|ref|className|style|children)$/]",
        "message": "<MediaGrid> doesn't accept that prop. Declared props: children, columns, gap, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NumberedStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:n|title|body|tone|style|key|ref|className|style|children)$/]",
        "message": "<NumberedStep> doesn't accept that prop. Declared props: n, title, body, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NumberedStep'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:peach|stone|mint|sky|pink|amber)$/]",
        "message": "<NumberedStep> tone must be one of 'peach' | 'stone' | 'mint' | 'sky' | 'pink' | 'amber'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageCounter'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|total|style|key|ref|className|style|children)$/]",
        "message": "<PageCounter> doesn't accept that prop. Declared props: index, total, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PullQuote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|author|role|align|style|key|ref|className|style|children)$/]",
        "message": "<PullQuote> doesn't accept that prop. Declared props: children, author, role, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PullQuote'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<PullQuote> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideShell'] > JSXAttribute > JSXIdentifier[name!=/^(?:style|children|key|ref|className|style|children)$/]",
        "message": "<SlideShell> doesn't accept that prop. Declared props: style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SplitPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|heading|body|children|swap|style|key|ref|className|style|children)$/]",
        "message": "<SplitPanel> doesn't accept that prop. Declared props: eyebrow, heading, body, children, swap, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
