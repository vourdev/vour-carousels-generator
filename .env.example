# Auth store (LibSQL/Turso). Local default is a file db.
DATABASE_URL="file:local-auth.db"
DATABASE_AUTH_TOKEN=""

# Better Auth
BETTER_AUTH_SECRET="change-me-32-chars-min"
BETTER_AUTH_URL="http://localhost:3000"

# Single seeded user
APP_USERNAME="admin@vourdev.local"
APP_PASSWORD="change-me-strong"

# Set to true ONLY when running the seed script
ALLOW_SIGNUP="false"

# AI models — Gemini free tier is the default; DeepSeek/MIMO optional (paid).
# The model dropdown lists only providers whose key(s) are present.
GOOGLE_GENERATIVE_AI_API_KEY=""
# Optional: override the Gemini model (default: gemini-flash-latest).
GEMINI_MODEL=""
DEEPSEEK_API_KEY=""
MIMO_API_KEY=""
MIMO_BASE_URL=""
MIMO_MODEL=""
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""
OMNIROUTE_API_KEY=""
OMNIROUTE_BASE_URL=""
# Bisa diisi nama model (misal: gpt-4o) ATAU ID Combo OmniRoute Anda (misal: my-combo-name)
OMNIROUTE_COMBO=""
OMNIROUTE_MODEL=""

# Cloudinary Image Hosting
CLOUDINARY_URL=""

# Buffer Scheduling API
BUFFER_TOKEN=""
BUFFER_IG_CHANNEL_ID=""
BUFFER_TIKTOK_CHANNEL_ID=""
