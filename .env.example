# This app is the display layer. AI keys, Cloudinary and Buffer live in the backend's
# .env (backend-vour-carousels), not here.

# Auth + data store (LibSQL/Turso), shared with the backend. Local default is a file db.
DATABASE_URL="file:local-auth.db"
DATABASE_AUTH_TOKEN=""

# Better Auth — must match the backend's, since it validates the same session cookie.
BETTER_AUTH_SECRET="change-me-32-chars-min"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Single seeded user
APP_USERNAME="admin@vourdev.local"
APP_PASSWORD="change-me-strong"

# Set to true ONLY when running the seed script
ALLOW_SIGNUP="false"

# Backend (Hono). User routes forward the caller's session cookie.
BACKEND_API_URL="http://localhost:3001"
# Ceiling on one backend call, in ms (default 600000).
BACKEND_TIMEOUT_MS=""
# Automation routes (/automation/*), used by /api/n8n-generate.
BACKEND_AUTOMATION_URL="http://localhost:3001"

# Key for automation callers (n8n): sent as x-api-key to /api/topics, /api/calendar and
# /api/n8n-generate, and forwarded to the backend, which checks the same variable.
# Unset = those API-key paths reject everything. Never reuse BETTER_AUTH_SECRET here.
AUTOMATION_SECRET=""
